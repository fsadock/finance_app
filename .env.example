# Database — SQLite file, relative to the project root
DATABASE_URL="file:./prisma/dev.db"

# Anthropic — AI transaction categorization and recurring detection (console.anthropic.com)
# Without it, sync still works; new transactions just stay in "Revisar".
ANTHROPIC_API_KEY="sk-ant-..."

# Pluggy — Open Finance Brasil aggregator (dashboard.pluggy.ai → Applications)
# The client id is a UUID; placeholders are rejected with a clear error.
PLUGGY_CLIENT_ID="00000000-0000-0000-0000-000000000000"
PLUGGY_CLIENT_SECRET="your-pluggy-client-secret"
