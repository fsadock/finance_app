generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  CASH
  LOAN
}

enum TxStatus {
  POSTED
  PENDING
  REVIEW
}

enum InvestmentType {
  STOCK
  ETF
  FIXED_INCOME
  CRYPTO
  FUND
  OTHER
}

enum RecurringCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Account {
  id                   String            @id @default(cuid())
  name                 String
  type                 AccountType
  institution          String
  currency             String            @default("BRL")
  balance              Float             @default(0)
  creditLimit          Float?
  availableCreditLimit Float?
  balanceCloseDate     DateTime?
  balanceDueDate       DateTime?
  minimumPayment       Float?
  hidden               Boolean           @default(false)
  pluggyItemId         String?
  pluggyAccountId      String?           @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  transactions         Transaction[]
  investments          Investment[]
  recurrings           Recurring[]
  creditCardBills      CreditCardBill[]
  snapshots            BalanceSnapshot[]
  goals                Goal[]
}

/// One row per account per day, written on every sync / manual balance edit.
/// Source of truth for the net worth history chart.
model BalanceSnapshot {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime
  balance   Float

  @@unique([accountId, date])
  @@index([date])
}

model CreditCardBill {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  pluggyBillId   String   @unique
  dueDate        DateTime
  totalAmount    Float
  minimumPayment Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId, dueDate])
}

model Category {
  id                String         @id @default(cuid())
  name              String         @unique
  icon              String?
  color             String?
  parentId          String?
  parent            Category?      @relation("CategoryParent", fields: [parentId], references: [id])
  children          Category[]     @relation("CategoryParent")
  group             String?
  excludeFromBudget Boolean        @default(false)
  rolloverEnabled   Boolean        @default(false)
  /// Positive amounts here are income; positive amounts in other categories are refunds (estornos).
  isIncome          Boolean        @default(false)
  /// IRPF deduction bucket: MEDICAL | EDUCATION | PENSION (PGBL) | ALIMONY
  irpfType          String?
  budgets           Budget[]
  transactions      Transaction[]
  recurrings        Recurring[]
  merchantRules     MerchantRule[]
  createdAt         DateTime       @default(now())
}

model Budget {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  monthlyLimit Float
  startMonth   String
  createdAt    DateTime @default(now())

  @@unique([categoryId, startMonth])
}

model Transaction {
  id                String     @id @default(cuid())
  accountId         String
  account           Account    @relation(fields: [accountId], references: [id])
  date              DateTime
  /// The day it hits the account or card bill. Same as `date` except installments some banks date with
  /// the purchase day (read as purchase + (n − 1) months). Months and totals use this; `date` stays as sent.
  chargeDate        DateTime
  amount            Float
  currency          String     @default("BRL")
  description       String
  merchantRaw       String?
  categoryId        String?
  category          Category?  @relation(fields: [categoryId], references: [id])
  status            TxStatus   @default(POSTED)
  notes             String?
  isRecurring       Boolean    @default(false)
  recurringId       String?
  recurring         Recurring? @relation(fields: [recurringId], references: [id])
  tags              Tag[]
  pluggyTxId        String?    @unique
  excludeFromBudget Boolean    @default(false)
  transferPairId    String?
  /// Pluggy structured data (Brazil): PIX | TED | DOC | BOLETO | …
  paymentMethod     String?
  /// Other side of a Pix/TED: name + document type. SELF = the account owner's own CPF.
  counterpartyName  String?
  counterpartyType  String?
  merchantName      String?
  merchantCnpj      String?
  merchantCnae      String?
  mcc               Int?
  /// Credit card "parcelado": installment n of total, original purchase
  installmentNumber Int?
  totalInstallments Int?
  purchaseAmount    Float?
  purchaseDate      DateTime?
  pluggyBillId      String?
  pluggyCategory    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([accountId, date])
  @@index([date])
  @@index([date, excludeFromBudget])
  @@index([accountId, chargeDate])
  @@index([chargeDate, excludeFromBudget])
  @@index([categoryId])
  @@index([status])
  @@index([transferPairId])
  @@index([recurringId])
  @@index([totalInstallments])
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @unique
  color        String?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  icon          String?
  color         String?
  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Recurring {
  id           String           @id @default(cuid())
  name         String
  amount       Float
  cadence      RecurringCadence
  nextDate     DateTime
  lastDate     DateTime?
  /// normalizeForGrouping() key of the merchant; links future transactions to this recurring
  pattern      String?
  accountId    String?
  account      Account?         @relation(fields: [accountId], references: [id])
  categoryId   String?
  category     Category?        @relation(fields: [categoryId], references: [id])
  active       Boolean          @default(true)
  confidence   Float            @default(1.0)
  detectedByAI Boolean          @default(false)
  createdAt    DateTime         @default(now())
  /// Set when the user edits it: their values win until a newer charge arrives
  editedAt     DateTime?
  /// JSON of the last automatic cadence/amount change (shown with an undo)
  autoChange   String?
  /// Key of an automatic change the user undid, so it isn't applied again
  rejectedChange String?
  transactions Transaction[]
}

model Investment {
  id           String         @id @default(cuid())
  accountId    String
  account      Account        @relation(fields: [accountId], references: [id])
  name         String
  ticker       String?
  type         InvestmentType
  quantity     Float
  currentPrice Float
  costBasis    Float
  currency     String         @default("BRL")
  asOf         DateTime       @default(now())
  createdAt    DateTime       @default(now())
}

model MerchantRule {
  id         String   @id @default(cuid())
  pattern    String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  confidence Float    @default(0.9)
  source     String   @default("AI")
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pattern])
}

model PluggyItem {
  id               String    @id @default(cuid())
  pluggyId         String    @unique
  connector        String
  status           String
  lastUpdated      DateTime?
  lastSyncedAt     DateTime?
  /// Open Finance consent expiry — sync stops silently after this
  consentExpiresAt DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
}

model AppConfig {
  key   String @id
  value String
}
